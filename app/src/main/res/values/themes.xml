<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The whole UI is Compose; this theme only controls the window behind it. -->
    <style name="Theme.NexaTV" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/nexa_background</item>
        <item name="android:colorBackground">@color/nexa_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
